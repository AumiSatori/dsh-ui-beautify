{
  "name": "dsh-claude-beautify",
  "displayName": "dsh-UI美化",
  "version": "0.3.22",
  "private": true,
  "type": "module",
  "description": "dsh-UI美化：独立配置任务卡片与输入栏的玻璃样式、进度与输出展示。",
  "license": "MIT",
  "main": "index.js",
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "scripts/profile.mjs", "scripts/restore-claude-slider.mjs", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "test:summary": "node test/summary-browser.mjs",
    "test:materials": "node test/material-browser.mjs",
    "test:theme-palette": "node test/theme-palette-browser.mjs",
    "test:composer": "node test/composer-browser.mjs",
    "install-plugin": "node scripts/profile.mjs install",
    "uninstall-plugin": "node scripts/profile.mjs uninstall",
    "check-plugin": "node scripts/profile.mjs check",
    "restore-slider": "node scripts/restore-claude-slider.mjs",
    "check-slider": "node scripts/restore-claude-slider.mjs --check"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "engines": { "node": ">=22.13.0" },
  "devDependencies": { "@playwright/test": "^1.56.1", "react": "^19.2.0", "react-dom": "^19.2.0", "esbuild": "^0.25.11" },
  "repository": { "type": "git", "url": "https://github.com/AumiSatori/dsh-claude-beautify.git" }
}
