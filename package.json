{
  "name": "dsh-ui-beautify",
  "displayName": "dsh-UI美化",
  "version": "0.4.4",
  "type": "module",
  "description": "DSH UI appearance settings: glass surfaces, task and Artifact cards, custom message bubbles, backgrounds, particles and focus mode. 界面材质、任务与产物卡片、消息气泡和背景动效。",
  "author": "AumiSatori",
  "homepage": "https://github.com/AumiSatori/dsh-ui-beautify#readme",
  "bugs": "https://github.com/AumiSatori/dsh-ui-beautify/issues",
  "icon": "./assets/icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "theme",
    "liquid-glass",
    "artifact",
    "particles"
  ],
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "scripts/profile.mjs",
    "scripts/restore-claude-slider.mjs",
    "scripts/desktop-startup-feedback.mjs",
    "scripts/early-opening-patch.mjs",
    "assets/early-opening.js",
    "assets/CONTEXT-WHALE-LICENSE.md",
    "assets/TURN-DIVIDER-ART.md",
    "assets/icon.svg",
    "assets/icon.png",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "vendor/lens/LICENSE",
    "docs/FEATURES.md",
    "docs/UNIFIED-ICONS.md",
    "docs/FULLSCREEN.md",
    "docs/SIDEBAR-ATTENTION.md",
    "docs/STREAM-REVEAL.md",
    "docs/SETTINGS-RESET.md",
    "docs/SETTINGS-TRANSFER.md",
    "docs/CUSTOM-OPENING.md",
    "docs/BACKGROUND-ONLY.md",
    "docs/BACKGROUND-CHAT-SURFACES.md",
    "docs/DELIVERY.md",
    "CHANGELOG.md",
    "server/",
    "assets/running-whale/",
    "docs/RUNNING-ANIMATION-PACKS.md",
    "scripts/build-animation-pack.mjs",
    "scripts/migrate-running-plugin.mjs",
    "scripts/running-animation-config.mjs",
    "scripts/running-pack-zip.mjs",
    "docs/RELEASE-0.4.0.md",
    "docs/RELEASE-0.4.1.md",
    "docs/validation-0.4.1.json",
    "docs/RELEASE-0.4.2.md",
    "docs/validation-0.4.2.json",
    "docs/validation-0.4.0.json",
    "docs/RELEASE-0.4.3.md",
    "docs/validation-0.4.3.json",
    "docs/RELEASE-0.4.4.md",
    "docs/validation-0.4.4.json"
  ],
  "scripts": {
    "build:lens": "node scripts/build-lens.mjs",
    "check:lens": "node scripts/build-lens.mjs --check",
    "test:unified-icons": "node test/unified-icons-browser.mjs && node test/unified-icons-client-browser.mjs",
    "test:fullscreen": "node test/fullscreen-browser.mjs",
    "test": "node --test test/*.test.mjs",
    "test:release": "node scripts/verify.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:browser": "node test/browser.mjs",
    "test:summary": "node test/summary-browser.mjs",
    "test:progress-liquid": "node test/progress-liquid-browser.mjs",
    "test:skills": "node test/skills-browser.mjs",
    "test:scope": "node test/summary-scope-browser.mjs",
    "test:artifact": "node test/artifact-browser.mjs",
    "test:file-open-hit-target": "node test/file-open-hit-target-browser.mjs",
    "test:materials": "node test/material-browser.mjs",
    "test:theme-palette": "node test/theme-palette-browser.mjs",
    "test:theme-switch": "node test/theme-switch-browser.mjs",
    "test:focus": "node test/background-only-browser.mjs",
    "test:focus-header": "node test/background-only-browser.mjs",
    "test:focus-performance": "node test/background-only-browser.mjs",
    "test:startup": "node test/startup-motion-browser.mjs",
    "test:welcome": "node test/welcome-settings-browser.mjs",
    "test:welcome-media": "node test/welcome-media-browser.mjs",
    "test:welcome-code": "node test/welcome-code-browser.mjs",
    "test:theme-gesture": "node test/theme-assignments-gesture-browser.mjs",
    "test:early-opening": "node test/early-opening-browser.mjs",
    "test:settings": "node test/settings-browser.mjs",
    "test:settings-reset": "node test/settings-presets-browser.mjs",
    "test:settings-presets": "node test/settings-presets-browser.mjs",
    "test:settings-transfer": "node test/settings-transfer-browser.mjs",
    "test:background": "node test/background-browser.mjs",
    "test:background-surfaces": "node test/background-chat-surfaces-browser.mjs",
    "test:background-presented": "node test/background-presented-browser.mjs",
    "test:background-names": "node test/background-names-browser.mjs",
    "test:background-theme": "node test/background-theme-browser.mjs",
    "test:tabs": "node test/conversation-tabs-browser.mjs",
    "test:composer": "node test/composer-browser.mjs",
    "test:composer-scroll-motion": "node test/composer-scroll-motion-browser.mjs",
    "test:composer-placement": "node test/composer-placement-browser.mjs",
    "test:slider-glass": "node test/slider-glass-browser.mjs",
    "test:performance": "node test/performance-browser.mjs",
    "test:particle-performance": "node test/particle-performance-browser.mjs",
    "test:reading-performance": "node test/reading-turn-performance-browser.mjs",
    "test:sidebar": "node test/sidebar-browser.mjs",
    "test:sidebar-attention": "node test/sidebar-attention-browser.mjs",
    "test:sidebar-layout": "node test/sidebar-layout-browser.mjs",
    "test:sidebar-overlay": "node test/sidebar-overlay-browser.mjs",
    "test:conversation-width": "node test/conversation-width-browser.mjs",
    "test:messages": "node test/message-motion-browser.mjs",
    "test:chat-disclosure": "node test/chat-disclosure-browser.mjs",
    "test:stream-reveal": "node test/stream-reveal-browser.mjs",
    "test:user-bubbles": "node test/user-bubbles-browser.mjs",
    "test:turn-cards": "node test/turn-cards-browser.mjs",
    "test:turn-divider": "node test/turn-divider-browser.mjs",
    "install-plugin": "node scripts/profile.mjs install",
    "uninstall-plugin": "node scripts/profile.mjs uninstall",
    "check-plugin": "node scripts/profile.mjs check",
    "restore-slider": "node scripts/restore-claude-slider.mjs",
    "check-slider": "node scripts/restore-claude-slider.mjs --check",
    "test:context-particles": "node test/context-particles-browser.mjs",
    "test:particle-conversion": "node test/particle-conversion-browser.mjs",
    "test:whale-particles": "node test/whale-particles-browser.mjs",
    "test:header-project": "node test/header-project-browser.mjs",
    "test:particle-images": "node test/particle-image-browser.mjs",
    "test:running": "node test/running-browser.mjs",
    "pack:running": "node scripts/build-animation-pack.mjs",
    "test:opening-themes": "node test/theme-media-browser.mjs",
    "test:settings-hierarchy": "node test/settings-hierarchy-toolbar-browser.mjs",
    "test:hero-greeting": "node test/hero-greeting-browser.mjs",
    "test:process-disclosure": "node test/process-disclosure-browser.mjs",
    "test:output-preview-animation": "node test/output-preview-animation.mjs",
    "test:settings-config-motion": "node test/settings-config-motion-browser.mjs",
    "test:output-copy": "node test/output-copy-browser.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "esbuild": "^0.25.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AumiSatori/dsh-ui-beautify.git"
  }
}
